---
import Base from '../../layouts/Base.astro';
import { getPosts, categoriesInUse } from '../../lib/content.js';
const labels = { writing: 'Writing', reflections: 'Reflections', studies: 'Studies', music: 'Music' };
export function getStaticPaths() {
  return categoriesInUse().map(({ key }) => ({ params: { category: key }, props: { category: key } }));
}
const { category } = Astro.props; const posts = getPosts().filter((post) => post.category.key === category);
---
<Base title={labels[category]}>
<section class="listing"><span class="kicker" style={`--c:${posts[0]?.category.color || '#b8321e'}`}><i></i>Category</span><h1>{labels[category]}</h1><p class="meta">{posts.length} {posts.length === 1 ? 'piece' : 'pieces'}</p>
<div class="grid">{posts.map((post) => <a class="card" href={`/essays/${post.slug}/`}>{post.banner ? <div class="img"><img src={post.banner} alt="" /></div> : <div class="cover" style={`--c:${post.category.color}`}><span class="cover-title">{post.title}</span></div>}<span class="kicker" style={`--c:${post.category.color}`}><i></i>{post.category.label}</span><h3>{post.title}</h3><p>{post.deck}</p>{post.formattedDate && <span class="meta card-date">{post.formattedDate}</span>}</a>)}</div></section>
</Base>
