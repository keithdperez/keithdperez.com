---
import Base from '../layouts/Base.astro';
import Contents from '../components/Contents.astro';
import { getPosts, getAbout } from '../lib/content.js';
const posts = getPosts();
// Hold the deploy until something is live (Keith, 2026-11-24): an empty production site never ships.
if (import.meta.env.PROD && posts.length === 0 && process.env.INCLUDE_UNREVIEWED !== '1') {
  throw new Error('No live essays: mark at least one note publish: true and reviewed: true before building for production.');
}
const about = getAbout();
const tagline = about?.tagline || "I'm Keith Perez, and this is where I think out loud.";
---
<Base>
  <section class="intro">
    <h1>{tagline}</h1>
    <p class="intro-links"><a href="/about/">More about me <span aria-hidden="true">→</span></a></p>
  </section>
  <section class="toc" aria-labelledby="toc-h">
    <h2 id="toc-h" class="label">Contents</h2>
    <Contents posts={posts} />
  </section>
</Base>
