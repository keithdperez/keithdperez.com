---
import '../styles/rubric-fonts.css';
import '../styles/site.css';
const { title = 'Keith D. Perez', description = 'Essays, studies, and reflections by Keith D. Perez.', type = 'website', image = null } = Astro.props;
const here = Astro.url.pathname;
const url = new URL(here, Astro.site);
const fullTitle = title === 'Keith D. Perez' ? title : `${title} · Keith D. Perez`;
// Shares always carry a picture: the essay's banner, or the site card.
const ogImage = new URL(image || '/og.png', Astro.site);
const current = (href) => (here === href ? 'page' : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdfcf9" />
    <title>{fullTitle}</title>
    <link rel="canonical" href={url} />
    <link rel="preload" href="/fonts/rubric-serif-normal-400-900.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/archivo-latin-var.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <meta property="og:site_name" content="Keith D. Perez" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="Keith D. Perez" href="/rss.xml" />
  </head>
  <body>
    <Fragment set:html={`<!-- Direction (Keith, 2026-11-24): "Rubric". A liturgical book, not a magazine.
  World: Aeon-born materials kept — Alegreya (Rubric Serif), wide Archivo caps, one red #b8321e, paper #fdfcf9.
  Home: a hymnal contents page; each row is number, title, one line, and the gift it hands you.
  Essay: the gift is promised under the title and handed over at the end; outside links are numbered sources in the margin.
  Rules: no eyebrows, no cards, no pigment covers; red marks only what the reader can act on or find again. -->`} />
    <a class="skip" href="#main">Skip to the writing</a>
    <header class="mast">
      <a class="name" href="/" aria-current={current('/')}>Keith D. Perez<span>.</span></a>
      <nav aria-label="Main">
        <a href="/" aria-current={current('/')}>Contents</a>
        <a href="/about/" aria-current={current('/about/')}>About</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="foot">
      <a href="/">Keith D. Perez</a>
      <a href="/rss.xml">RSS</a>
    </footer>
  </body>
</html>
