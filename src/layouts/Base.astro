---
import '../styles/rubric-fonts.css';
import Icon from '../components/Icon.astro';
const { title = 'Keith D. Perez', description = 'Essays, studies, and reflections by Keith D. Perez.', type = 'website' } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'Keith D. Perez' ? title : `${title} · Keith D. Perez`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fdfcf9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121417" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={url} />
    <meta property="og:site_name" content="Keith D. Perez" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(Astro.props.image || '/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/archivo-latin-wdth-wght.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/rubric-serif-normal-400-900.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Keith D. Perez" href="/rss.xml" />
  </head>
  <body>
    <header class="mast">
      <a class="face" href="/" aria-label="Keith D. Perez, home"><img src="/avatar.webp" alt="Keith D. Perez" width="80" height="80" /></a>
      <nav aria-label="Main navigation">
        <a href="/writing/">Writing</a><a href="/about/">About</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer><a class="face face-sm" href="/" aria-label="Keith D. Perez, home"><img src="/avatar.webp" alt="" width="64" height="64" loading="lazy" /></a><a class="feed" href="/rss.xml" aria-label="RSS feed"><Icon name="rss" size={18} /></a></footer>
  </body>
</html>
<style is:global>
:root{color-scheme:light dark;--paper:#fdfcf9;--paper-2:#f3f0e8;--ink:#1b1a17;--ink-2:#5e5a52;--rule:#e2ddd2;--line:var(--ink);--red:#b8321e;--red-deep:#93250f;--fill:var(--red);--red-rgb:184,50,30;--lapis:#2c4f9e;--verdigris:#2d7766;--orpiment:#b58515;--murex:#7a2f66;--on-pigment:var(--paper);--action:var(--ink);--action-hover:var(--red);--on-action:var(--paper);--highlight:rgba(214,170,40,.3);--serif:"Rubric Serif",Georgia,serif;--sans:"Archivo","Rubric Sans",Helvetica,sans-serif}*{box-sizing:border-box}html{background:var(--paper)}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--serif);-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}img{display:block;width:100%;height:100%;object-fit:cover}.wide{font-family:var(--sans);font-stretch:125%;font-weight:700;text-transform:uppercase;letter-spacing:.06em}.meta{font:400 13px/1.4 var(--sans);color:var(--ink-2)}.mast{display:flex;justify-content:space-between;align-items:center;padding:22px 48px;border-bottom:1px solid var(--line)}.mast nav{display:flex;gap:28px}.mast nav a{display:inline-flex;align-items:center;min-height:44px;margin-block:-14px;padding-inline:4px;margin-inline:-4px;font:500 12px/1 var(--sans);font-stretch:125%;letter-spacing:.12em;text-transform:uppercase}.mast nav a:hover{color:var(--red)}footer{border-top:1px solid var(--line);padding:24px 48px;display:flex;justify-content:space-between;gap:20px;font:12px var(--sans);color:var(--ink-2)}footer a:first-child{font-weight:700;color:var(--ink)}
.hero{display:grid;grid-template-columns:1fr;gap:40px;padding:72px 48px 40px;align-items:end}.hero:has(.img){grid-template-columns:1.6fr 1fr}.hero>div{max-width:860px}.hero .img{aspect-ratio:16/9;overflow:hidden}.hero h1,.hero h2{font:500 80px/1 var(--serif);letter-spacing:-.015em;margin:0 0 18px}.deck{font:italic 400 24px/1.4 var(--serif);color:var(--ink-2);margin:0 0 20px}.hero .meta{display:block}.hero .meta:after{content:"";display:block;width:32px;height:1px;background:var(--red);margin-top:18px}.sec{display:flex;justify-content:space-between;align-items:baseline;margin:16px 48px 0;padding-top:14px;border-top:1px solid var(--line)}
/* Rows, one language at every width: a pigment square, the title, the deck; a red tile at the right edge only when the piece gives something. */
.grid{display:grid;grid-template-columns:repeat(2,1fr);column-gap:72px;padding:8px 48px 72px}.card{display:grid;grid-template-columns:10px 1fr auto;column-gap:16px;align-items:start;align-content:start;padding:26px 0;border-top:1px solid var(--rule)}.recent-grid .card:nth-child(-n+2){border-top:0}.card .img{grid-column:1/-1;aspect-ratio:4/3;overflow:hidden;margin-bottom:16px}.dot{width:10px;height:10px;margin-top:9px;background:var(--c)}.card h3{grid-column:2;font:500 26px/1.15 var(--serif);margin:0 0 6px}.card p{grid-column:2;font:400 16px/1.45 var(--serif);color:var(--ink-2);margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.card:hover h3{color:var(--red)}.card .card-gift{grid-column:3;grid-row:1/3;align-self:center;display:grid;place-items:center;width:36px;height:36px;margin:0 0 0 16px;background:var(--fill);color:var(--on-action)}.card .lbl{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.essay-hero{height:560px;overflow:hidden}.essay-head{max-width:880px;margin:56px auto 0;padding:0 24px;text-align:center}.essay-head h1{font:500 76px/1 var(--serif);letter-spacing:-.015em;margin:22px 0 20px}.essay-head .deck{font-size:24px;max-width:640px;margin:0 auto 28px}.byline{display:flex;justify-content:center;gap:22px;padding:14px 0;border-block:1px solid var(--rule);max-width:640px;margin:0 auto}.body{max-width:640px;margin:44px auto 0;padding:0 24px;font:400 21px/1.6 var(--serif)}.body p{margin:0 0 1.1em}.body p.first:first-letter{float:left;font:500 5.1em/.8 var(--serif);color:var(--red);padding:.06em .08em 0 0}.body h2{font:500 12px/1 var(--sans);font-stretch:125%;letter-spacing:.16em;text-transform:uppercase;color:var(--red);margin:2.2em 0 1em}.scripture{border-left:1px solid var(--red);padding:2px 0 2px 22px;margin:1.6em 0;font-size:19px;line-height:1.55}.scripture sup{color:var(--red);font:700 11px var(--sans);margin-right:4px}.scripture .ref{display:block;margin-top:8px;font:500 11px/1 var(--sans);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-2)}.pull{margin:1.8em -80px;padding:26px 0;border-block:1px solid var(--line);font:italic 400 34px/1.2 var(--serif);text-align:center}.pull:before{content:"";display:block;width:28px;height:2px;background:var(--red);margin:0 auto 18px}.end{display:inline-block;width:10px;height:10px;background:var(--red);margin-left:8px;vertical-align:baseline}.listing{padding:48px}.listing h1{font:500 52px/1.05 var(--serif);margin:16px 0 10px}.listing .grid{padding:24px 0}.about{max-width:700px;margin:64px auto 96px;padding:0 24px;font-size:21px;line-height:1.6}.about h1{font-size:56px;line-height:1.05;margin:14px 0 24px}.about>div>p:first-child{font:italic 400 24px/1.4 var(--serif);color:var(--ink-2)}
.promise{display:grid;grid-template-columns:44px 1fr;grid-template-rows:auto auto;column-gap:16px;row-gap:2px;align-items:center;max-width:640px;margin:0 auto;padding:0;color:var(--ink);text-align:left}.promise .icon{grid-row:1/3;width:44px;height:44px;padding:12px;background:var(--fill);color:var(--on-action);transition:background-color .2s}.promise:hover .icon{background:var(--red-deep)}.promise-text{align-self:end}.promise .promise-label{font:500 18px/1.25 var(--serif);color:var(--ink)}.promise:hover .promise-label{color:var(--red)}.promise>.meta{grid-column:2;align-self:start;margin:0;font-size:12px}.card-gift{display:flex;align-items:center;gap:8px;font:500 15px/1.3 var(--serif);color:var(--ink)}.hero .card-gift{margin:0 0 22px;min-height:56px;padding:0 20px;gap:14px;width:max-content;max-width:100%;background:var(--fill);color:var(--on-action);font-size:18px}.hero .card-gift .meta{margin-left:12px;color:inherit;opacity:.82;font-size:12px}.hero .card-gift .meta:after{display:none}a.card-gift:hover{background:var(--red-deep)}:focus-visible{outline:2px solid var(--red);outline-offset:3px}
@media(max-width:800px){.mast{padding:18px 24px;align-items:flex-start;gap:20px}.mast nav{gap:14px;flex-wrap:wrap;justify-content:flex-end}.mast nav a{font-size:11px}.hero,.hero:has(.img){grid-template-columns:1fr;gap:22px;padding:40px 24px 24px}.hero h1,.hero h2{font-size:56px}.grid{grid-template-columns:1fr;padding:8px 24px 48px}.sec{margin-inline:24px}.essay-hero{height:42vw;min-height:220px}.essay-head{margin-top:36px}.essay-head h1{font-size:56px}.pull{margin-inline:0}.listing{padding:36px 24px}footer{padding:20px 24px}}
@media(max-width:480px){.deck{font-size:20px}.sec{margin:8px 20px 0}.about{font-size:18px;margin-top:40px}.listing h1{font-size:42px}.scripture{font-size:17px;padding-left:16px}.pull{font-size:27px}footer{padding:18px 20px;font-size:10px}}
/* Phone (Keith, 2026-11-26): no covers, the list is type, the gift is one red tile at the top and again at the end, the essay reads left-aligned. A real banner still runs full-bleed. */
@media(max-width:480px){
.mast{display:flex;align-items:center;padding:14px 20px}.mast nav{margin:0 -10px 0 0;gap:0}.mast nav a{font-size:10px;padding-inline:10px;margin-inline:0}
.hero{display:block;padding:28px 20px 20px}.hero h1,.hero h2{font-size:52px;line-height:1.02;margin:0 0 14px}.hero .img{display:block;aspect-ratio:4/3;margin:-28px -20px 22px}.hero .card-gift{width:auto}
.grid,.listing .grid{display:block;padding:0 20px 40px}.listing{padding:28px 0 0}.listing h1{padding-inline:20px;margin-bottom:8px}
.card{padding:20px 0}.card:first-child{border-top:0}.recent-grid .card:nth-child(2){border-top:1px solid var(--rule)}.card .img{margin:0 -20px 16px}.card h3{font-size:22px;margin-bottom:6px}.card p{font-size:15px}.dot{margin-top:8px}
.essay-hero{height:auto;aspect-ratio:4/3}
.essay-head{margin-top:32px;padding-inline:24px;text-align:left}.essay-head h1{font-size:40px;line-height:1.04;margin:0 0 12px}.essay-head .deck{font-size:18px;max-width:none;margin:0 0 14px}
.byline{justify-content:flex-start;border:0;padding:0;margin:0 0 20px;font-size:12px}.promise{margin:0}
.body{margin-top:28px;font-size:19px;line-height:1.65;padding-inline:24px}.body p.first:first-letter{float:none;font:inherit;color:inherit;padding:0}
.about h1{font-size:44px;font-weight:500}.about>div>p:first-child{font-size:22px}
}
/* Vault lineage (Rubric theme, ~/vault/.obsidian/themes/Rubric): links are directions, ink words with a red underline; marks are highlighter; a section break is three red points. */
::selection{background:rgba(var(--red-rgb),.18)}.body a,.about a{text-decoration:underline;text-decoration-thickness:1px;text-decoration-color:rgba(var(--red-rgb),.6);text-underline-offset:.2em;transition:text-decoration-color .15s}.body a:hover,.about a:hover{text-decoration-color:currentColor}.body mark{background:linear-gradient(transparent 55%,var(--highlight) 55%);color:inherit;padding:0 .05em}.body hr{border:0;height:1em;margin:2.2em 0;text-align:center;overflow:visible}.body hr:after{content:"· · ·";color:var(--red);letter-spacing:.4em;font-size:.85em}.body blockquote{margin:1.6em 0;padding:2px 0 2px 22px;border-left:1px solid var(--red)}.body code{font-size:.82em;padding:.08em .3em;background:var(--paper-2)}
/* Dark: the vault by lamplight. Same ground, ink and vermilion as Rubric's dark theme; what the site adds is light: a warm wash from above, images rest dimmed (as in the vault) and rise to full strength when touched. */
@media (prefers-color-scheme:dark){
:root{--paper:#121417;--paper-2:#181b1f;--ink:#ebe6dc;--ink-2:#a7a196;--rule:#262a30;--line:#3a3f47;--red:#ff7b63;--fill:color-mix(in srgb,#ff7b63 85%,#121417);--red-deep:#ff9a86;--red-rgb:255,123,99;--lapis:#7d9be6;--verdigris:#5fb8a3;--orpiment:#e2b54a;--murex:#c77bb1;--on-pigment:#f6f1e7;--action:var(--red);--action-hover:var(--red-deep);--on-action:#121417;--highlight:rgba(226,181,74,.22)}
::selection{background:rgba(var(--red-rgb),.24)}
body{background:radial-gradient(120% 60% at 50% -10%,rgba(255,196,140,.045),transparent 60%) no-repeat,var(--paper)}
.mast,footer{border-color:var(--rule)}hr.sec{border-top-color:var(--rule)}
.hero .img img,.card .img img,.essay-hero img,.body img{filter:brightness(.88) saturate(.92);transition:filter .5s cubic-bezier(.16,1,.3,1)}
.hero .img:hover img,.card:hover .img img,.body img:hover{filter:none}


.body code{background:var(--paper-2)}
}
@media (prefers-color-scheme:dark) and (prefers-reduced-motion:reduce){.hero .img img,.card .img img,.essay-hero img,.body img{transition:none}}
/* The end of a piece speaks in shapes (Keith, 2026-11-26): the gift is a filled red tile at the top and the end; the next piece is a row with an arrow. No labels. */
.take{display:grid;grid-template-columns:64px 1fr;align-items:center;gap:18px;max-width:640px;margin:56px auto 0;padding:0 24px;color:var(--ink)}.take-mark{display:grid;place-items:center;width:64px;height:64px;background:var(--fill);color:var(--on-action);transition:background-color .2s}.take-mark .icon{transition:transform .35s cubic-bezier(.16,1,.3,1)}.take-text{display:flex;flex-direction:column;gap:6px;min-width:0}.take-label{font:500 24px/1.2 var(--serif);text-wrap:balance}.take:hover .take-mark{background:var(--red-deep)}.take-download:hover .take-mark .icon{transform:translateY(3px)}.take-link:hover .take-mark .icon,.take-song:hover .take-mark .icon{transform:translate(2px,-2px)}
.next{display:grid;grid-template-columns:1fr 44px;align-items:center;gap:16px;min-height:64px;max-width:640px;margin:64px auto 72px;padding:16px 24px 0;border-top:1px solid var(--rule);color:var(--ink)}.next-title{font:500 24px/1.2 var(--serif);text-wrap:balance}.next .icon{width:44px;height:44px;padding:13px;border:1px solid var(--rule);color:var(--red);transition:transform .35s cubic-bezier(.16,1,.3,1)}.next:hover .icon{transform:translateX(4px)}.next:hover .next-title{color:var(--red)}
hr.sec{border:0;border-top:1px solid var(--line);height:0;padding:0;margin-bottom:8px}
footer{align-items:center}.feed{display:grid;place-items:center;width:44px;height:44px;margin:-12px -12px -12px 0;color:var(--ink-2)}.feed:hover{color:var(--red)}
@media(max-width:480px){.take{grid-template-columns:56px 1fr;gap:16px;margin-top:40px;padding-inline:24px}.take-mark{width:56px;height:56px}.take-label{font-size:20px}.next{margin:36px 24px 48px;padding:16px 0 0}.next-title{font-size:22px}footer{flex-direction:row;padding:14px 20px}}
@media(prefers-reduced-motion:reduce){.take-mark .icon,.next .icon{transition:none}}
/* The mark is Keith's face (Keith, 2026-11-26): a circle in place of the wordmark, a hairline ring that turns red on hover. */
.face{display:block;flex:none;width:44px;height:44px;border-radius:50%;overflow:hidden;box-shadow:0 0 0 1px var(--rule);transition:box-shadow .2s}.face img{width:100%;height:100%;object-fit:cover}.face:hover{box-shadow:0 0 0 2px var(--red)}.face-sm{width:32px;height:32px}.mast{padding-block:14px}
/* Desktop reads like a note in the vault: one centered column for the lead and the list, not a spread (Keith, 2026-11-26). */
@media(min-width:801px){.hero,hr.sec,.grid,.listing{max-width:720px;margin-inline:auto;padding-inline:0}.hero{display:block;padding-top:72px;padding-bottom:40px}.hero h1{font-size:64px}.hero .deck{font-size:23px;max-width:34ch}.grid,.listing .grid{display:block;column-gap:0;padding-bottom:96px}.listing{padding-top:64px}.listing h1{font-size:56px}.mast,footer{padding-inline:max(48px,calc((100% - 720px)/2))}.recent-grid .card:nth-child(2){border-top:1px solid var(--rule)}.essay-head{max-width:640px;margin-top:72px;padding:0 24px;text-align:left}.essay-head h1{font-size:64px;line-height:1.02;margin:0 0 16px}.essay-head .deck{font-size:22px;max-width:none;margin:0 0 18px}.byline{justify-content:flex-start;border:0;padding:0;margin:0 0 28px;max-width:none;font-size:12px}.promise{margin:0}}
@media(max-width:480px){.face{width:36px;height:36px}.face-sm{width:28px;height:28px}}
</style>
