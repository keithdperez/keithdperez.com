---
// One stroke family for the few marks the site needs: what a gift is, and where a link goes.
const { name, size = 16 } = Astro.props;
const paths = {
  download: 'M8 2.5v8M4.5 7 8 10.5 11.5 7M3 13.5h10',
  song: 'M6 12.2V3.5l7-1.5v8.7M6 12.2a1.8 1.8 0 1 1-3.6 0 1.8 1.8 0 0 1 3.6 0Zm7-1.5a1.8 1.8 0 1 1-3.6 0 1.8 1.8 0 0 1 3.6 0Z',
  link: 'M6 3.5H3.5v9h9V10M9 3h4v4M13 3 7.5 8.5',
  arrow: 'M3 8h10M9 4l4 4-4 4',
  back: 'M13 8H3M7 4 3 8l4 4',
};
---
<svg class={`icon icon-${name}`} width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[name]} /></svg>
