{
  "settings": {
    "lineinfo": true,
    "suppress-empty-chords": true
  },
  "pdf": {
    "papersize": "letter",
    "theme": {
      "foreground": "#1a1a1a",
      "background": "#fffff8"
    },
    "fonts": {
      "title": {
        "name": "Times-Roman",
        "size": 24,
        "color": "#000000"
      },
      "subtitle": {
        "name": "Times-Roman",
        "size": 12,
        "color": "#4a4a4a"
      },
      "text": {
        "name": "Times-Roman",
        "size": 13,
        "color": "#1a1a1a"
      },
      "chord": {
        "name": "Times-Roman",
        "size": 11,
        "color": "#1a1a1a"
      },
      "comment": {
        "name": "Times-Italic",
        "size": 11,
        "color": "#666666"
      },
      "comment_italic": {
        "name": "Times-Italic",
        "size": 11,
        "color": "#666666"
      },
      "tab": {
        "name": "Courier",
        "size": 10,
        "color": "#1a1a1a"
      },
      "annotation": {
        "name": "Times-Italic",
        "size": 10,
        "color": "#666666"
      }
    },
    "spacing": {
      "title": 3,
      "lyrics": 1.5,
      "chords": 1.5
    },
    "chorus": {
      "indent": 0,
      "bar": {
        "offset": 0,
        "width": 0,
        "color": "#ffffff"
      },
      "tag": "",
      "recall": {
        "quote": false,
        "tag": ""
      }
    },
    "footspace": 30,
    "headspace": 35,
    "marginbottom": 60,
    "margintop": 60,
    "marginleft": 65,
    "marginright": 65
  },
  "diagnostics": {
    "format": "\"ChordPro: Ink on Paper - Classic Times Roman typography (ETBembo equivalent)\""
  }
}
